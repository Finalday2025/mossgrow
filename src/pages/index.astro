---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout>
  <main class="container">
    <header class="site-header">
      <h1 class="site-title">mossgrow</h1>
      <p class="site-subtitle">记录成长，点滴积累</p>
    </header>

    {posts.length === 0 ? (
      <p class="empty">还没有文章，敬请期待。</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li class="post-item">
            <a href={`${import.meta.env.BASE_URL}/blog/${post.id}/`} class="post-link">
              <div class="post-meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('zh-CN', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
              </div>
              <h2 class="post-title">{post.data.title}</h2>
              {post.data.description && (
                <p class="post-description">{post.data.description}</p>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</Layout>

<style>
  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
      'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
    color: #1f2937;
    line-height: 1.7;
  }

  .site-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .site-title {
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .site-subtitle {
    margin: 0.5rem 0 0;
    color: #6b7280;
    font-size: 1rem;
  }

  .empty {
    color: #6b7280;
    font-style: italic;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-item {
    margin-bottom: 2rem;
  }

  .post-link {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 1.5rem;
    border-radius: 12px;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .post-link:hover {
    background-color: #f9fafb;
  }

  .post-meta {
    margin-bottom: 0.5rem;
  }

  .post-meta time {
    font-size: 0.875rem;
    color: #9ca3af;
  }

  .post-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: #111827;
  }

  .post-description {
    margin: 0;
    color: #6b7280;
    font-size: 0.95rem;
  }
</style>
