---
import Layout from '../layouts/Layout.astro';
---

<Layout title="页面未找到" description="你访问的页面不存在">
  <main class="container">
    <div class="error">
      <p class="error-code">404</p>
      <h1 class="error-title">页面未找到</h1>
      <p class="error-message">你访问的页面不存在或已被移除。</p>
      <a href={`${import.meta.env.BASE_URL}/`} class="home-link">返回首页</a>
    </div>
  </main>
</Layout>

<style>
  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
      'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
    color: #1f2937;
    text-align: center;
  }

  .error {
    margin-top: 4rem;
  }

  .error-code {
    font-size: 5rem;
    font-weight: 800;
    margin: 0;
    color: #e5e7eb;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .error-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 1rem 0 0.5rem;
  }

  .error-message {
    color: #6b7280;
    margin: 0 0 2rem;
  }

  .home-link {
    display: inline-block;
    padding: 0.6rem 1.5rem;
    background: #111827;
    color: #ffffff;
    text-decoration: none;
    border-radius: 8px;
    font-size: 0.95rem;
    transition: background-color 0.2s ease;
  }

  .home-link:hover {
    background: #374151;
  }
</style>
