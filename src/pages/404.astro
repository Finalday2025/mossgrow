---
import Layout from '../layouts/Layout.astro';
---

<Layout title="页面未找到" description="你访问的页面不存在">
  <div class="box">
    <nav class="nav">
      <a href={`${import.meta.env.BASE_URL}/`} class="logo">mossgrow</a>
      <ul>
        <li><a href={`${import.meta.env.BASE_URL}/`}>首页</a></li>
      </ul>
    </nav>

    <main class="error-page">
      <p class="error-code">404</p>
      <h1 class="error-title">页面未找到</h1>
      <p class="error-message">你访问的页面不存在或已被移除。</p>
      <a href={`${import.meta.env.BASE_URL}/`} class="home-link">返回首页</a>
    </main>

    <footer class="ft">
      <p>© {new Date().getFullYear()} mossgrow · 用心记录每一天</p>
    </footer>
  </div>
</Layout>

<style>
  .box {
    max-width: 1040px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 0 1.25rem;
    margin-bottom: 3.5rem;
    position: relative;
  }

  .nav::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--soft), transparent);
    opacity: 0.4;
  }

  .logo {
    font: 600 2rem 'Caveat', cursive;
    color: var(--main);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    transform: rotate(-0.5deg);
  }

  .logo::before {
    content: '❧';
    color: #8ab88e;
    font-size: 1.1rem;
    transform: rotate(-8deg);
  }

  .nav ul {
    display: flex;
    gap: 2rem;
  }

  .nav a {
    color: #6a7a6e;
    font-size: 1rem;
    position: relative;
    transition: color 0.25s;
  }

  .nav a:hover {
    color: var(--main);
  }

  .error-page {
    text-align: center;
    padding: 4rem 0;
  }

  .error-code {
    font: 700 5rem 'Gloria Hallelujah', cursive;
    color: var(--soft);
    line-height: 1;
    opacity: 0.6;
  }

  .error-title {
    font: 400 1.8rem 'Ma Shan Zheng', 'Long Cang', 'Gloria Hallelujah', cursive;
    color: var(--main);
    margin: 1rem 0 0.5rem;
  }

  .error-message {
    color: var(--mute);
    margin-bottom: 2rem;
  }

  .home-link {
    display: inline-block;
    padding: 0.5rem 1.5rem;
    background: var(--main);
    color: #ffffff;
    border-radius: 9999px;
    font: 1.1rem 'Caveat', cursive;
    transition: background-color 0.2s ease;
  }

  .home-link:hover {
    background: var(--soft);
  }

  .ft {
    margin-top: 6rem;
    padding-top: 2.5rem;
    text-align: center;
    font: 1.1rem 'Caveat', cursive;
    color: var(--mute);
    border-top: 1px dashed rgba(106, 154, 120, 0.3);
  }

  .ft::before {
    content: '~';
    display: block;
    color: #8ab88e;
    font-size: 1.5rem;
    line-height: 0.5;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 520px) {
    .error-code {
      font-size: 3.5rem;
    }
    .error-title {
      font-size: 1.5rem;
    }
  }
</style>